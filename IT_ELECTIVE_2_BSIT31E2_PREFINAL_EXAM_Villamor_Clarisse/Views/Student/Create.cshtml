@model IT_ELECTIVE_2_BSIT31E2_PREFINAL_EXAM_Villamor_Clarisse.Models.StudentViewModel
<body class="container">
<h1 class="Title">Add Student</h1>

<form asp-controller="Student" asp-action="Create" method="post">


    <div class="mb-3">
        <label asp-for="StudentNumber" class="form-label"></label>

        <input asp-for="StudentNumber" class="form-control" />

        <span asp-validation-for="StudentNumber"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>

        <input asp-for="FirstName" class="form-control" />

        <span asp-validation-for="FirstName"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="MiddleName" class="form-label"></label>

        <input asp-for="MiddleName" class="form-control" />

        <span asp-validation-for="MiddleName"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>

        <input asp-for="LastName" class="form-control" />

        <span asp-validation-for="LastName"
              class="text-danger"></span>
    </div>


    


    <div class="mb-3">
        <label asp-for="SectionId" class="form-label">
            Section
        </label>

        <select asp-for="SectionId" class="form-control">

            <option value="">
                -- Select Section --
            </option>

            @foreach (var sec in Model.Sections)
            {
                <option value="@sec.SectionId">
                    @sec.SectionName
                </option>
            }

        </select>

        <span asp-validation-for="SectionId"
              class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
</body>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}