@model IT_ELECTIVE_2_BSIT31E2_PREFINAL_EXAM_Villamor_Clarisse.Models.Student
<body class="container2">
<h1 class="Title2">Delete Student</h1>

<h3 class="ominous">Are you sure you want to delete this student?</h3>

<div class="card mt-3">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Student Number
            </dt>
            <dd class="col-sm-9">
                @Model.StudentNumber
            </dd>

            <dt class="col-sm-3">
                Middle Name
            </dt>
            <dd class="col-sm-9">
                @Model.MiddleName
            </dd>

            <dt class="col-sm-3">
                First Name
            </dt>
            <dd class="col-sm-9">
                @Model.FirstName
            </dd>

            <dt class="col-sm-3">
                Last Name
            </dt>
            <dd class="col-sm-9">
                @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Section
            </dt>
            <dd class="col-sm-9">
                @Model.Section?.SectionName
            </dd>

        </dl>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="StudentId" />

                <button type="submit" class="btn btn-danger delete-btn">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>

            <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                const deleteButtons = document.querySelectorAll(".delete-btn");

                                deleteButtons.forEach(btn => {
                                    btn.addEventListener("click", function (e) {
                                        e.preventDefault(); 

                                      
                                        const scare = document.createElement("div");
                                        scare.style.position = "fixed";
                                        scare.style.top = "0";
                                        scare.style.left = "0";
                                        scare.style.width = "100%";
                                        scare.style.height = "100%";
                                        scare.style.background = "black url('/images/eyes.png') center/contain no-repeat";
                                        scare.style.zIndex = "9999";

                                        document.body.appendChild(scare);

                                        const scream = new Audio("/sounds/scream.mp3"); 
                                        scream.play();
                                       
                                        setTimeout(() => {
                                            btn.closest("form").submit();
                                        }, 2000);
                                    });
                                });
                            });
            </script>

    </div>
</div>
</body>